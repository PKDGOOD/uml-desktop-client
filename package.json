{
  "name": "uml-desktop-client",
  "version": "0.1.0",
  "description": "Local UML editor with a text DSL and interactive canvas \u2014 early alpha",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --mode browser --host 127.0.0.1",
    "electron:dev": "npm run dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:readiness": "vitest --run src/engine/readinessRegression.test.ts src/engine/alphaFixtures.test.ts",
    "qa:packaged": "node scripts/smoke-packaged.mjs",
    "qa:baseline": "node scripts/measure-baseline.mjs",
    "check": "npm run typecheck && npm run repo:check && npm test",
    "build:app": "npm run typecheck && vite build",
    "build": "npm run notices:check && npm run build:app && electron-builder",
    "pack": "npm run notices:check && npm run build:app && electron-builder --dir",
    "preview": "vite preview",
    "repo:check": "node scripts/check-repo.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check"
  },
  "keywords": [
    "uml",
    "electron",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "konva": "^10.2.3",
    "monaco-editor": "^0.55.1",
    "peggy": "^5.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-konva": "^19.2.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "fast-check": "^4.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.3"
  },
  "build": {
    "appId": "com.umlstudio.desktop",
    "productName": "UML Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "mac": {
      "identity": "-",
      "target": [
        "zip"
      ]
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.uml-studio"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ]
  },
  "author": "UML Studio contributors",
  "homepage": "https://github.com/PKDGOOD/uml-desktop-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PKDGOOD/uml-desktop-client.git"
  },
  "bugs": {
    "url": "https://github.com/PKDGOOD/uml-desktop-client/issues"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
